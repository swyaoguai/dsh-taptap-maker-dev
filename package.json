{
  "name": "dsh-game-forge",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "游戏工坊 / Game Forge —— 通用游戏开发工作流插件 (DSH bundle)：按项目进度与需求挑 skill（立项→原型→内容→美术音频→手感→测试→上线），零额度产出图片 / 音效 / BGM / 动作帧素材，并守住「非用户主动不消耗 Maker MCP 内置额度」的红线。TapTap Maker (UrhoX + Lua) 只是支持的引擎之一，Godot / Unity / Unreal / 网页项目同样适用。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "game-image-relay": "./src/game-image-relay.mjs",
    "game-audio": "./src/game-audio.mjs",
    "game-image": "./src/game-image-web.mjs",
    "game-zaiduyu": "./src/game-zaiduyu.mjs",
    "game-sfx": "./src/game-sfx.mjs",
    "game-cocos": "./src/cocos/cli.mjs",
    "game-skills-update": "./src/game-skills-update.mjs"
  },
  "scripts": {},
  "files": [
    "index.js",
    "client.js",
    "src",
    "skills",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md",
    "third_party/GameFactory-3A/LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "game-development",
    "game-dev-workflow",
    "game-assets",
    "godot",
    "unity",
    "cocos-creator",
    "mcp",
    "taptap-maker",
    "skills"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swyaoguai/dsh-game-forge.git"
  },
  "homepage": "https://github.com/swyaoguai/dsh-game-forge#readme",
  "bugs": {
    "url": "https://github.com/swyaoguai/dsh-game-forge/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
